# Local demo defaults: mock Gemini, in-memory data, local evidence storage.
GEMINI_BACKEND=mock
STORE_BACKEND=memory
EVENTS_BACKEND=log
BLOB_BACKEND=local
AUTH_MODE=none

# Use Gemini through Vertex AI in a dedicated hackathon project.
# GEMINI_BACKEND=vertex
# GOOGLE_CLOUD_PROJECT=your-hackathon-project
# VERTEX_LOCATION=us-central1
# GEMINI_FAST_MODEL=gemini-2.5-flash

# Optional Google Cloud adapters. Enable only after provisioning the resources.
# STORE_BACKEND=firestore
# EVENTS_BACKEND=pubsub
# BLOB_BACKEND=gcs
# EVIDENCE_BUCKET=your-hackathon-project-evidence
# AUTH_MODE=firebase
# DLP_ENABLED=true
# WEBRISK_ENABLED=true
# INDICATOR_HMAC_SALT=load-this-from-secret-manager-in-cloud-run

# Alternative: Gemini API key from Google AI Studio.
# GEMINI_BACKEND=apikey
# GEMINI_API_KEY=your-key

GEMINI_FALLBACK_TO_MOCK=true
